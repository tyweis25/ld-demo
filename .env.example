# Copy to .env and fill in. Never commit .env.
# LD_SDK_KEY: Project settings → Environments → server-side SDK key (not the client-side ID).
LD_SDK_KEY=sdk-your-server-side-key

# Optional: live AI answers. Without it the assistant gives simulated replies.
ANTHROPIC_API_KEY=

# Optional: makes the "Turn Off AI Assistant" button on the web page work.
# This is a LaunchDarkly API access token, NOT your SDK key. The SDK key can only read flags.
# This token can change them, so give it the narrowest role you can and delete it after the demo.
LD_API_TOKEN=
LD_PROJECT_KEY=default
# Must be the environment your SDK key belongs to, for example test or production
LD_ENV_KEY=
# EU accounts only: LD_API_BASE=https://app.eu.launchdarkly.com

# Optional: remediate the Harbor Dusk skin via LaunchDarkly flag trigger (generic "turn flag off").
# Create on flag new-booking-ui → environment configuration → Add trigger → Generic → Turn flag off.
# Paste the secret URL here. Never commit it. Then: ./run.sh remediate
# (Does not turn off new-checkout-flow — form flow targeting stays as configured.)
LD_FLAG_TRIGGER_URL=

# Optional overrides
# FLAG_KEY=new-checkout-flow
# UI_FLAG_KEY=new-booking-ui

# Optional: port for the Python booking-agent sidecar started by ./run.sh web
# BOOKING_PORT=8081
